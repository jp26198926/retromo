# Database (PostgreSQL connection string)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/retromo"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-string"
BETTER_AUTH_URL="http://localhost:3000"

# Admin
# The email address of the admin user. A user with this email is automatically
# an admin (can also promote other users to admin from the admin panel).
ADMIN_EMAIL="admin@example.com"

# Google OAuth (optional — leave commented to hide the "Continue with Google" button)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (optional — leave commented to hide the "Continue with GitHub" button)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# PayPal (for subscription payments)
# Get these from https://developer.paypal.com/dashboard/ under Apps & Credentials
NEXT_PUBLIC_PAYPAL_ENVIRONMENT="sandbox"  # or "production"
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""  # server-only, never expose this

# SMTP email configuration (for team invitation emails)
# If these are not set, invitations are still created but no email is sent.
# The invitation link is returned in the API response so it can be shared manually.
# For Gmail, use an App Password (not your regular password) and port 587.
# Example:
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="587"
#   SMTP_USER="your-email@gmail.com"
#   SMTP_PASS="your-app-password"
#   SMTP_FROM="your-email@gmail.com"
#   SMTP_FROM_NAME="RetroMo"
#   SMTP_SECURE="false"  # use "true" for port 465 (SSL)

# Cloudinary (for admin logo/favicon uploads to cloud storage)
# Get these from your Cloudinary console dashboard:
#   https://console.cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME="RetroMo"
SMTP_SECURE="false"
